# Supabase Configuration
# Get these values from https://app.supabase.com/project/_/settings/api

# Public variables (exposed to app)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_API_URL=http://localhost:3000

# Demo account for Google Play Store review (optional)
# Remove these variables to disable demo login
NEXT_PUBLIC_DEMO_EMAILS=userreview@finnon.app,user-en@finnon.app
DEMO_OTP_CODE=XXXXXX
DEMO_USER_PASSWORD=your-demo-password-here
